{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spektrorganize",
  "version": "0.1.0",
  "identifier": "dev.alexharding.spektrorganize",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "spektrorganize",
        "width": 1320,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**", "$CACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": {
      "../../../vendor/spektrafilm-data": "spektrafilm-data",
      "../../../presets": "presets"
    }
  }
}
